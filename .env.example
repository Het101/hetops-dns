# ── HetOps DNS configuration ───────────────────────────────────
# Copy to .env (or set in your deploy environment). All values are optional;
# sensible defaults apply and email runs in console mode if SMTP is unset.

# Server
PORT=3000
NODE_ENV=production

# Public base URL used to build magic-link sign-in URLs and alert links.
# Defaults to the request's own host if unset.
APP_URL=https://dns.hetops.dev

# Allowed browser origins (comma-separated). Defaults include localhost + dns.hetops.dev.
# CORS_ORIGINS=https://dns.hetops.dev,https://example.com

# SQLite database file location (mount a volume here in Docker).
DB_PATH=/app/data/hetops.db

# ── Email (SMTP via nodemailer) ──
# If SMTP_HOST is unset, sign-in links and alerts are logged to the server
# console instead of being emailed (handy for local development).
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=HetOps DNS <no-reply@hetops.dev>

# Alert checks interval in milliseconds (default 30 min).
# ALERT_INTERVAL_MS=1800000

# Response cache TTL in milliseconds (default 5 min).
# CACHE_TTL_MS=300000

# ── DMARC report ingestion ──
# Shared secret between the Cloudflare Email Worker (secret INGEST_SECRET) and this app.
# Use a long random value, e.g. `openssl rand -hex 32`. Unset = ingestion disabled (503).
# DMARC_INGEST_SECRET=
# Domain shown in users' report addresses (dmarc-<token>@<domain>).
# DMARC_DOMAIN=hetops.dev
